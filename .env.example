# Copie para .env e preencha. NUNCA commite o .env real.
# PostgreSQL (Neon, Supabase...). Ex.: postgresql://usuario:senha@host/banco?sslmode=require
# Sem ela o site funciona com os dados de exemplo e o painel /admin fica desligado.
DATABASE_URL=
# (não usado: as sessões do painel são tokens aleatórios com hash no banco)
SESSION_SECRET=
APP_URL=http://localhost:3000

# Pagamento
PAGAMENTO_API_KEY=
PAGAMENTO_WEBHOOK_SECRET=

# Captcha (Turnstile/hCaptcha)
CAPTCHA_SECRET=
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# Storage (S3/R2)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# E-mail
EMAIL_API_KEY=
